# Python
__pycache__/
*.py[cod]
.venv/
.uv_cache/
*.egg-info/
.pytest_cache/
.ruff_cache/

# Data
# 01-raw: echte data genegeerd, alleen demo-bronbestanden in git
data/01-raw/*
!data/01-raw/demo/

# 02-prepared en 03-output: gegenereerde output, nooit in git
# Mappen zelf vrijgesteld zodat .gitkeep erin werkt
data/02-prepared/**
!data/02-prepared/**/
!data/02-prepared/**/.gitkeep
data/03-output/**
!data/03-output/**/
!data/03-output/**/.gitkeep

# OS / editor
.DS_Store
.idea/
.vscode/

# Make dev/stop (Streamlit)
.streamlit/.dev.pid
.streamlit/.dev.log

# Ruwe .asc bronbestanden decodeertabellen (te groot; CSV-versies staan in metadata/)
src/mbo_bekostiging_bestanden/metadata/*.asc
src/mbo_bekostiging_bestanden/metadata/Bestandsbeschrijving_Dec-bestanden.txt

# Extern gedownloade bronbestanden (scripts/ regenereren deze)
data/external/

# Gegenereerde documentatiesite
site/

# Tijdelijke bestanden en lokale referentiedocumenten
afbeelding*.png
toelichting_onderwijsresultaten*.txt
scripts/debug_dashboard.py
