{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Quality Report for MBO Ingest Star Schema",
  "description": "Machine-readable quality metrics for each run. Written to data/03-output/{scenario}/star/quality.json by run_star().",
  "type": "object",
  "properties": {
    "timestamp": {
      "type": "string",
      "description": "ISO 8601 timestamp of star build",
      "examples": [
        "2025-09-25T12:34:56Z"
      ]
    },
    "scenario": {
      "type": "string",
      "description": "Scenario label passed explicitly by the caller (run_star(scenario=...), CLI --scenario, app config); 'unknown' when not given. Never derived from the output path.",
      "examples": [
        "demo"
      ]
    },
    "deliveries": {
      "type": "array",
      "description": "Per-delivery quality report",
      "items": {
        "type": "object",
        "properties": {
          "levering": {
            "type": "string",
            "description": "Delivery identifier (filename stem)"
          },
          "schema_type": {
            "type": "string",
            "enum": [
              "ro",
              "grondslag",
              "tbgi",
              "unknown"
            ],
            "description": "Detected schema type from recordtypes"
          },
          "slr_status": {
            "type": "string",
            "enum": [
              "match",
              "mismatch",
              "unknown"
            ],
            "description": "SLR reconciliation status"
          },
          "slr_details": {
            "type": "object",
            "description": "Per recordtype: expected vs actual counts",
            "additionalProperties": {
              "type": "object",
              "properties": {
                "verwacht": {
                  "type": "integer"
                },
                "gelezen": {
                  "type": "integer"
                }
              },
              "required": [
                "verwacht",
                "gelezen"
              ],
              "additionalProperties": false
            },
            "examples": [
              {
                "PER": {
                  "verwacht": 100,
                  "gelezen": 100
                }
              }
            ]
          },
          "parseverlies": {
            "type": "object",
            "description": "Fields where typed values became null (filled → empty)",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": {
                "type": "integer"
              }
            },
            "examples": [
              {
                "VLP": {
                  "DatumBegin": 2
                }
              }
            ]
          },
          "warnings": {
            "type": "array",
            "description": "Non-fatal issues",
            "items": {
              "type": "string"
            }
          },
          "errors": {
            "type": "array",
            "description": "Fatal issues (should trigger fail)",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "levering",
          "schema_type",
          "slr_status",
          "slr_details",
          "parseverlies",
          "warnings",
          "errors"
        ],
        "additionalProperties": false
      }
    },
    "star": {
      "type": "object",
      "description": "Cross-delivery star schema checks",
      "properties": {
        "orphaned_facts": {
          "type": "object",
          "description": "Detail facts not joining to fact_inschrijving",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "total_rows": {
                "type": "integer"
              },
              "orphaned_rows": {
                "type": "integer"
              },
              "orphaned_pct": {
                "type": "number"
              }
            },
            "required": [
              "total_rows",
              "orphaned_rows",
              "orphaned_pct"
            ],
            "additionalProperties": false
          },
          "examples": [
            {
              "fact_bekostiging": {
                "total_rows": 1000,
                "orphaned_rows": 50,
                "orphaned_pct": 0.05
              }
            }
          ]
        },
        "key_duplicates": {
          "type": "object",
          "description": "Period keys appearing >1x in fact_inschrijving",
          "properties": {
            "duplicate_keys": {
              "type": "integer"
            },
            "affected_rows": {
              "type": "integer"
            },
            "by_delivery": {
              "type": "object",
              "additionalProperties": {
                "type": "integer"
              }
            }
          },
          "required": [
            "duplicate_keys",
            "affected_rows",
            "by_delivery"
          ],
          "additionalProperties": false
        },
        "overlapping_deliveries": {
          "type": "array",
          "description": "Inschrijvingen (BRIN × _persoon_id × Inschrijvingvolgnummer) die na canonicalisatie nog in meer dan één levering staan. Elke treffer is dubbeltelling en maakt de status 'fail'.",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string",
                "description": "BRIN|_persoon_id|Inschrijvingvolgnummer"
              },
              "deliveries": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "count": {
                "type": "integer"
              }
            },
            "required": [
              "key",
              "deliveries",
              "count"
            ],
            "additionalProperties": false
          }
        },
        "niveau_issues": {
          "type": "object",
          "description": "Rows with unknown or missing niveau",
          "properties": {
            "unknown_code": {
              "type": "integer"
            },
            "sbb_without_level": {
              "type": "integer"
            },
            "total": {
              "type": "integer"
            }
          },
          "required": [
            "unknown_code",
            "sbb_without_level",
            "total"
          ],
          "additionalProperties": false
        },
        "canonicalisatie": {
          "type": "object",
          "description": "Canonicalisatie van overlappende leveringen (#174/#175): welke leveringen zijn vervangen, door welke en waarom. Bron: star-tabel meta_canonicalisatie.",
          "properties": {
            "regel": {
              "type": "string",
              "description": "Toegepaste voorkeursregel in leesbare vorm"
            },
            "vervangen_inschrijvingen": {
              "type": "integer",
              "minimum": 0
            },
            "vervangen_isp_perioden": {
              "type": "integer",
              "minimum": 0
            },
            "per_levering": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "levering": {
                    "type": "string",
                    "description": "Vervangen (oudere) levering"
                  },
                  "vervangen_door": {
                    "type": "string",
                    "description": "Winnende levering"
                  },
                  "reden": {
                    "type": "string",
                    "enum": [
                      "recentere_aanmaakdatum",
                      "leveringsnaam"
                    ]
                  },
                  "inschrijvingen": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "isp_perioden": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "required": [
                  "levering",
                  "vervangen_door",
                  "reden",
                  "inschrijvingen",
                  "isp_perioden"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "regel",
            "vervangen_inschrijvingen",
            "vervangen_isp_perioden",
            "per_levering"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "orphaned_facts",
        "key_duplicates",
        "overlapping_deliveries",
        "niveau_issues",
        "canonicalisatie"
      ],
      "additionalProperties": false
    },
    "summary": {
      "type": "object",
      "description": "Summary metrics",
      "properties": {
        "total_deliveries": {
          "type": "integer"
        },
        "total_inschrijvingen": {
          "type": "integer"
        },
        "total_warnings": {
          "type": "integer"
        },
        "total_errors": {
          "type": "integer"
        },
        "status": {
          "type": "string",
          "enum": [
            "pass",
            "warn",
            "fail"
          ],
          "description": "Overall status: pass (no errors), warn (warnings only), fail (has errors)"
        }
      },
      "required": [
        "total_deliveries",
        "total_inschrijvingen",
        "total_warnings",
        "total_errors",
        "status"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "timestamp",
    "scenario",
    "deliveries",
    "star",
    "summary"
  ],
  "additionalProperties": false
}
