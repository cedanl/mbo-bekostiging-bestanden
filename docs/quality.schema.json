{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Quality Report for MBO Ingest Star Schema",
  "description": "Machine-readable quality metrics for each run. Written to <target>/quality.json by run_star(); the app uses <output>/star.",
  "type": "object",
  "properties": {
    "timestamp": {
      "type": "string",
      "description": "ISO 8601 timestamp of star build",
      "examples": [
        "2025-09-25T12:34:56Z"
      ]
    },
    "scenario": {
      "type": "string",
      "description": "Scenario label passed explicitly by the caller (run_star(scenario=...), CLI --scenario, app config); 'unknown' when not given. Never derived from the output path.",
      "examples": [
        "demo"
      ]
    },
    "deliveries": {
      "type": "array",
      "description": "Per-delivery quality report",
      "items": {
        "type": "object",
        "properties": {
          "levering": {
            "type": "string",
            "description": "Leveringslabel, gelijk aan de levering-kolom in de ster en meta_leveringen (pad t.o.v. relative_to, anders mapnaam)"
          },
          "schema_type": {
            "type": "string",
            "enum": [
              "ro",
              "grondslag",
              "tbgi",
              "unknown"
            ],
            "description": "Detected schema type from recordtypes"
          },
          "slr_status": {
            "type": "string",
            "enum": [
              "match",
              "mismatch",
              "unknown",
              "not_applicable"
            ],
            "description": "SLR reconciliation status"
          },
          "slr_details": {
            "type": "object",
            "description": "Per recordtype: expected vs actual counts",
            "additionalProperties": {
              "type": "object",
              "properties": {
                "verwacht": {
                  "type": "integer"
                },
                "gelezen": {
                  "type": "integer"
                }
              },
              "required": [
                "verwacht",
                "gelezen"
              ],
              "additionalProperties": false
            },
            "examples": [
              {
                "PER": {
                  "verwacht": 100,
                  "gelezen": 100
                }
              }
            ]
          },
          "parseverlies": {
            "type": "object",
            "description": "Fields where typed values became null (filled → empty)",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": {
                "type": "integer"
              }
            },
            "examples": [
              {
                "VLP": {
                  "DatumBegin": 2
                }
              }
            ]
          },
          "regelinventaris": {
            "type": "object",
            "description": "Wat de ingest niet inlas (#120); leeg voor TBGI (XML)",
            "properties": {
              "onbekende_recordtypes": {
                "type": "object",
                "additionalProperties": {
                  "type": "integer"
                }
              },
              "velden_voorbij_schema": {
                "type": "object",
                "additionalProperties": {
                  "type": "integer"
                }
              },
              "spiegel_afwijkingen": {
                "type": "object",
                "additionalProperties": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "integer"
                  }
                }
              }
            },
            "additionalProperties": false
          },
          "domeinafwijkingen": {
            "type": "object",
            "description": "Per recordtype en veld: gevulde waarden buiten hun waardedomein (#205), met ernst (#238)",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "aantal": {
                    "type": "integer"
                  },
                  "ernst": {
                    "type": "string",
                    "enum": ["error", "warning"]
                  }
                },
                "required": ["aantal", "ernst"],
                "additionalProperties": false
              }
            }
          },
          "warnings": {
            "type": "array",
            "description": "Non-fatal issues",
            "items": {
              "type": "string"
            }
          },
          "errors": {
            "type": "array",
            "description": "Fatal issues (should trigger fail)",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "levering",
          "schema_type",
          "slr_status",
          "slr_details",
          "parseverlies",
          "regelinventaris",
          "domeinafwijkingen",
          "warnings",
          "errors"
        ],
        "additionalProperties": false
      }
    },
    "star": {
      "type": "object",
      "description": "Cross-delivery star schema checks",
      "properties": {
        "orphaned_facts": {
          "type": "object",
          "description": "Detail facts not joining to fact_inschrijving",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "total_rows": {
                "type": "integer"
              },
              "orphaned_rows": {
                "type": "integer"
              },
              "orphaned_pct": {
                "type": "number"
              },
              "explained_rows": {
                "type": "integer",
                "description": "Wees-rijen die volgens het relatiecontract geen FK-fout zijn (optionele parent); tellen niet als error"
              },
              "explanation": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "total_rows",
              "orphaned_rows",
              "orphaned_pct",
              "explained_rows",
              "explanation"
            ],
            "additionalProperties": false
          },
          "examples": [
            {
              "fact_bekostiging": {
                "total_rows": 1000,
                "orphaned_rows": 50,
                "orphaned_pct": 0.05,
                "explained_rows": 0,
                "explanation": null
              }
            }
          ]
        },
        "key_duplicates": {
          "type": "object",
          "description": "Per uniciteitscontract (bijv. fact_inschrijving, fact_inschrijving_schooljaar, hoofdinschrijving_per_schooljaar): sleutels die meer dan één keer voorkomen",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "feit": {
                "type": "string"
              },
              "sleutel": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "duplicate_keys": {
                "type": "integer"
              },
              "affected_rows": {
                "type": "integer"
              },
              "by_delivery": {
                "type": "object",
                "additionalProperties": {
                  "type": "integer"
                }
              }
            },
            "required": [
              "feit",
              "sleutel",
              "duplicate_keys",
              "affected_rows",
              "by_delivery"
            ],
            "additionalProperties": false
          }
        },
        "overlapping_deliveries": {
          "type": "array",
          "description": "Inschrijvingen (BRIN × _persoon_id × Inschrijvingvolgnummer) die na canonicalisatie nog in meer dan één levering staan. Elke treffer is dubbeltelling en maakt de status 'fail'.",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string",
                "description": "BRIN|_persoon_id|Inschrijvingvolgnummer"
              },
              "deliveries": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "count": {
                "type": "integer"
              }
            },
            "required": [
              "key",
              "deliveries",
              "count"
            ],
            "additionalProperties": false
          }
        },
        "niveau_issues": {
          "type": "object",
          "description": "Rows with unknown or missing niveau",
          "properties": {
            "unknown_code": {
              "type": "integer"
            },
            "sbb_without_level": {
              "type": "integer"
            },
            "total": {
              "type": "integer"
            }
          },
          "required": [
            "unknown_code",
            "sbb_without_level",
            "total"
          ],
          "additionalProperties": false
        },
        "leveringen_zonder_schooljaar": {
          "type": "array",
          "description": "Leveringen met inschrijvingen maar zonder waarneembare peildatum (geen rij in fact_inschrijving_schooljaar), zie meta_leveringen.Peilgrens (#211)",
          "items": {
            "type": "object",
            "properties": {
              "levering": {
                "type": "string"
              },
              "inschrijvingen": {
                "type": "integer"
              }
            },
            "required": [
              "levering",
              "inschrijvingen"
            ],
            "additionalProperties": false
          }
        },
        "join_keuzes": {
          "type": "array",
          "description": "Koppelingen waar een sleutel meer dan één kandidaat had; de gekozen rij is deterministisch (#209)",
          "items": {
            "type": "object",
            "properties": {
              "koppeling": {
                "type": "string"
              },
              "sleutel": {
                "type": "string"
              },
              "meervoudige_sleutels": {
                "type": "integer"
              },
              "weggelaten_rijen": {
                "type": "integer"
              }
            },
            "required": [
              "koppeling",
              "sleutel",
              "meervoudige_sleutels",
              "weggelaten_rijen"
            ],
            "additionalProperties": false
          }
        },
        "canonicalisatie": {
          "type": "object",
          "description": "Canonicalisatie van overlappende leveringen (#174/#175): welke leveringen zijn vervangen, door welke en waarom. Bron: star-tabel meta_canonicalisatie.",
          "properties": {
            "regel": {
              "type": "string",
              "description": "Toegepaste voorkeursregel in leesbare vorm"
            },
            "vervangen_inschrijvingen": {
              "type": "integer",
              "minimum": 0
            },
            "vervangen_isp_perioden": {
              "type": "integer",
              "minimum": 0
            },
            "per_levering": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "levering": {
                    "type": "string",
                    "description": "Vervangen (oudere) levering"
                  },
                  "vervangen_door": {
                    "type": "string",
                    "description": "Winnende levering"
                  },
                  "reden": {
                    "type": "string",
                    "enum": [
                      "recentere_aanmaakdatum",
                      "leveringsnaam"
                    ]
                  },
                  "inschrijvingen": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "isp_perioden": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "required": [
                  "levering",
                  "vervangen_door",
                  "reden",
                  "inschrijvingen",
                  "isp_perioden"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "regel",
            "vervangen_inschrijvingen",
            "vervangen_isp_perioden",
            "per_levering"
          ],
          "additionalProperties": false
        },
        "verouderde_kolommen": {
          "type": "object",
          "description": "Per tabel de jaargebonden kolommen die verouderd zijn en in v4.0.0 verdwijnen; gebruik fact_inschrijving_schooljaar (#201)",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "dr_scope": {
          "type": "object",
          "description": "Instellingen (BRIN) in fact_inschrijving_schooljaar waarbinnen DR- en Entree-uitstroom bepaald zijn (#118). Uitstroom zoekt de persoon in t+1 bij al deze instellingen; een overstap naar een instelling buiten de dataset telt als uitstroom. mbo_breed is false: de dataset bevat alleen eigen leveringen",
          "properties": {
            "brins": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "mbo_breed": {
              "type": "boolean"
            }
          },
          "required": [
            "brins",
            "mbo_breed"
          ],
          "additionalProperties": false
        },
        "dekking": {
          "type": "array",
          "description": "Per levering × recordtype: ingelezen records tegen rijen in het analysemodel (#295). Alleen een volledig gat (bereikt 0) krijgt een ernst: error voor bekostigingsrecords, anders warning. Recordtypes zonder eigen feit hebben feit en bereikt null en een verklaring",
          "items": {
            "type": "object",
            "properties": {
              "levering": {
                "type": "string"
              },
              "recordtype": {
                "type": "string"
              },
              "feit": {
                "type": ["string", "null"]
              },
              "ingelezen": {
                "type": "integer"
              },
              "bereikt": {
                "type": ["integer", "null"]
              },
              "ernst": {
                "enum": ["error", "warning", null]
              },
              "verklaring": {
                "type": ["string", "null"]
              }
            },
            "required": [
              "levering",
              "recordtype",
              "feit",
              "ingelezen",
              "bereikt",
              "ernst",
              "verklaring"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "orphaned_facts",
        "key_duplicates",
        "overlapping_deliveries",
        "niveau_issues",
        "canonicalisatie",
        "join_keuzes",
        "leveringen_zonder_schooljaar",
        "verouderde_kolommen",
        "dr_scope",
        "dekking"
      ],
      "additionalProperties": false
    },
    "summary": {
      "type": "object",
      "description": "Summary metrics",
      "properties": {
        "total_deliveries": {
          "type": "integer"
        },
        "total_inschrijvingen": {
          "type": "integer"
        },
        "total_warnings": {
          "type": "integer"
        },
        "total_errors": {
          "type": "integer"
        },
        "status": {
          "type": "string",
          "enum": [
            "pass",
            "warn",
            "fail"
          ],
          "description": "Overall status: pass (no errors), warn (warnings only), fail (has errors)"
        }
      },
      "required": [
        "total_deliveries",
        "total_inschrijvingen",
        "total_warnings",
        "total_errors",
        "status"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "timestamp",
    "scenario",
    "deliveries",
    "star",
    "summary"
  ],
  "additionalProperties": false
}
